<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Admin Panel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body class="bg-gray-100 p-4 md:p-8">
    <div class="max-w-5xl mx-auto">
        <div class="flex justify-between mb-8">
            <h1 class="text-2xl font-bold">Admin Dashboard</h1>
            <div class="flex gap-2"><a href="/" class="bg-gray-200 px-4 py-2 rounded">Site</a><a href="/logout"
                    class="bg-red-500 text-white px-4 py-2 rounded">Logout</a></div>
        </div>
        <form action="/admin/add" method="POST"
            class="bg-white p-6 rounded-2xl shadow-sm mb-8 grid grid-cols-1 md:grid-cols-4 gap-4">
            <input type="text" name="category" placeholder="Category" required class="border p-2 rounded">
            <input type="text" name="name" placeholder="Name" required class="border p-2 rounded">
            <input type="text" name="url" placeholder="URL" required class="border p-2 rounded">
            <input type="text" name="description" placeholder="Description" required class="border p-2 rounded">
            <button class="bg-blue-600 text-white rounded font-bold p-2 md:col-span-4">+ Add Link</button>
        </form>
        <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
            <div class="p-4 border-b flex justify-between items-center">
                <h2 class="font-bold">Manage Links</h2>
                <form action="/admin" method="GET" class="relative"><input type="text" name="q" value="<%= q %>"
                        placeholder="Search..." class="pl-8 pr-4 py-1 border rounded text-sm"><i
                        class="fa fa-search absolute left-3 top-2.5 text-gray-400 text-xs"></i></form>
            </div>
            <table class="w-full text-left">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="p-4">Name</th>
                        <th class="p-4 text-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% entries.forEach(item=> { %>
                        <tr class="border-t hover:bg-gray-50">
                            <td class="p-4 font-bold text-sm">
                                <%= item.name %>
                            </td>
                            <td class="p-4 flex gap-4 text-sm"><button onclick='editModal(<%- JSON.stringify(item) %>)'
                                    class="text-blue-600">Edit</button>
                                <form action="/admin/delete/<%= item._id %>" method="POST"><button
                                        class="text-red-500">Delete</button></form>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <div id="modal" class="fixed inset-0 bg-black/50 hidden flex items-center justify-center p-4">
        <form action="/admin/edit" method="POST"
            class="bg-white p-6 rounded-2xl w-full max-w-md flex flex-col gap-4 shadow-2xl">
            <h3 class="text-xl font-bold">Edit Link</h3><input type="hidden" name="id" id="e-id">
            <input type="text" name="category" id="e-cat" class="border p-2 rounded" placeholder="Category">
            <input type="text" name="name" id="e-name" class="border p-2 rounded" placeholder="Name">
            <input type="text" name="url" id="e-url" class="border p-2 rounded" placeholder="URL">
            <textarea name="description" id="e-desc" class="border p-2 rounded" placeholder="Description"></textarea>
            <div class="flex justify-end gap-2"><button type="button"
                    onclick="document.getElementById('modal').classList.add('hidden')"
                    class="p-2 text-gray-500">Cancel</button><button
                    class="bg-blue-600 text-white px-4 py-2 rounded">Save</button></div>
        </form>
    </div>
    <script>function editModal(data) { document.getElementById('e-id').value = data._id; document.getElementById('e-cat').value = data.category; document.getElementById('e-name').value = data.name; document.getElementById('e-url').value = data.url; document.getElementById('e-desc').value = data.description; document.getElementById('modal').classList.remove('hidden'); }</script>
</body>

</html>